pipeline {
    agent any

    environment {
        AZURE_SUBSCRIPTION_ID = credentials('azure-subscription-id')
        AZURE_TENANT_ID       = credentials('azure-tenant-id')
        AZURE_CLIENT_ID       = credentials('azure-client-id')
        AZURE_CLIENT_SECRET   = credentials('azure-client-secret')
        RESOURCE_GROUP        = 'my-azure-functiondemo_group-b294'
        FUNCTION_APP_NAME     = 'my-azure-functiondemo'
        AZURE_REGION          = 'canada central'
    }

    stages {
        stage('Build') {
            steps {
                echo '🔧 Building Azure Functions project...'
                script {
                    bat 'if exist node_modules rmdir /s /q node_modules'
                    bat 'npm install'
                    echo '✅ Build completed successfully'
                }
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                script {
                    try {
                        bat 'npm test'
                        echo '✅ All tests passed successfully'
                    } catch (Exception e) {
                        echo "❌ Tests failed: ${e.message}"
                        currentBuild.result = 'FAILURE'
                        error("Test stage failed")
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 Deploying to Azure Functions...'
                script {
                    try {
                        // Login to Azure using service principal
                        bat """
                        az login --service-principal -u ${env.AZURE_CLIENT_ID} -p ${env.AZURE_CLIENT_SECRET} --tenant ${env.AZURE_TENANT_ID}
                        az account set --subscription ${env.AZURE_SUBSCRIPTION_ID}
                        """

                        // Create deployment folder and zip
                        bat """
                        if exist deploy rmdir /s /q deploy
                        mkdir deploy
                        copy host.json deploy\\
                        copy package.json deploy\\
                        xcopy src deploy\\src /s /e /i /y
                        cd deploy && npm install --production
                        powershell Compress-Archive -Path deploy\\* -DestinationPath deployment.zip -Force
                        """

                        // Deploy to Azure
                        bat """
                        az functionapp deployment source config-zip ^
                            --resource-group ${env.RESOURCE_GROUP} ^
                            --name ${env.FUNCTION_APP_NAME} ^
                            --src deployment.zip
                        """

                        echo "🌐 Function deployed to: https://${env.FUNCTION_APP_NAME}.azurewebsites.net/api/HelloWorld"

                    } catch (Exception e) {
                        echo "❌ Deployment failed: ${e.message}"
                        currentBuild.result = 'FAILURE'
                        error("Deploy stage failed")
                    } finally {
                        bat 'az logout || echo Already logged out'
                    }
                }
            }
        }
    }

    post {
        success {
            echo '🎉 Pipeline completed successfully!'
            echo "✅ Build: Successful"
            echo "✅ Test: All tests passed"
            echo "✅ Deploy: Function deployed to Azure"
            echo "🌐 Access your function at: https://${env.FUNCTION_APP_NAME}.azurewebsites.net/api/HelloWorld"
        }
        failure {
            echo '❌ Pipeline failed. Please check the logs.'
        }
    }
}
