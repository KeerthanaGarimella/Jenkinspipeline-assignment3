pipeline {
    agent any
    
    environment {
        AZURE_SUBSCRIPTION_ID = credentials('azure-subscription-id')
        AZURE_TENANT_ID = credentials('azure-tenant-id')
        AZURE_CLIENT_ID = credentials('azure-client-id')
        AZURE_CLIENT_SECRET = credentials('azure-client-secret')
        RESOURCE_GROUP = 'my-azure-functiondemo_group-b294'
        FUNCTION_APP_NAME = 'my-azure-functiondemo'
        AZURE_REGION = 'canada central'
    }
    
    stages {
        stage('Build') {
            steps {
                echo '🔧 Building Azure Functions project...'
                
                script {
                    bat 'if exist node_modules rmdir /s /q node_modules'
                    bat 'npm install'
                    echo '✅ Build completed successfully'
                }
            }
        }
        
        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                
                script {
                    try {
                        bat 'npm test'
                        echo '✅ All tests passed successfully'
                    } catch (Exception e) {
                        echo "❌ Tests failed: ${e.message}"
                        currentBuild.result = 'FAILURE'
                        error("Test stage failed")
                    }
                }
            }
        }

        // keep deploy stage for now, but az CLI might also need to run via PowerShell
    }
    
    post {
        always {
            echo '🧹 Cleaning up workspace...'
            
            script {
                bat 'if exist deployment.zip del /f /q deployment.zip'
                bat 'if exist deploy rmdir /s /q deploy'
            }
        }
        success {
            echo '🎉 Pipeline completed successfully!'
        }
        failure {
            echo '💥 Pipeline failed!'
        }
    }
}
