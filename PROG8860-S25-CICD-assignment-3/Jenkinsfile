pipeline {
    agent any

    environment {
        AZURE_SUBSCRIPTION_ID = credentials('azure-subscription-id')
        AZURE_TENANT_ID       = credentials('azure-tenant-id')
        AZURE_CLIENT_ID       = credentials('azure-client-id')
        AZURE_CLIENT_SECRET   = credentials('azure-client-secret')
        RESOURCE_GROUP        = 'my-azure-functiondemo_group-b294'
        FUNCTION_APP_NAME     = 'my-azure-functiondemo'
        AZURE_REGION          = 'canada central'
        AZ_CLI_PATH           = '"C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin\\az.cmd"'
    }

    stages {
        stage('Build') {
            steps {
                echo '🔧 Building Azure Functions project...'
                dir('PROG8860-S25-CICD-assignment-3') {
                    bat 'if exist node_modules rmdir /s /q node_modules'
                    bat 'npm install'
                }
                echo '✅ Build completed successfully'
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                dir('PROG8860-S25-CICD-assignment-3') {
                    script {
                        try {
                            bat 'npm test'
                            echo '✅ All tests passed successfully'
                        } catch (Exception e) {
                            echo "❌ Tests failed: ${e.message}"
                            currentBuild.result = 'FAILURE'
                            error("Test stage failed")
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 Deploying to Azure Functions...'
                script {
                    try {
                        // Login to Azure
                        bat """
                        ${AZ_CLI_PATH} login --service-principal -u ${AZURE_CLIENT_ID} -p ${AZURE_CLIENT_SECRET} --tenant ${AZURE_TENANT_ID}
                        ${AZ_CLI_PATH} account set --subscription ${AZURE_SUBSCRIPTION_ID}
                        """

                        // Prepare deployment directory and ZIP
                        bat """
                        if exist deploy rmdir /s /q deploy
                        mkdir deploy\\src
                        copy PROG8860-S25-CICD-assignment-3\\host.json deploy\\
                        copy PROG8860-S25-CICD-assignment-3\\package.json deploy\\
                        xcopy PROG8860-S25-CICD-assignment-3\\src deploy\\src /s /e /i /y
                        cd deploy && npm install --omit=dev && cd ..
                        powershell.exe -ExecutionPolicy Bypass -Command "Compress-Archive -Path deploy\\* -DestinationPath deployment.zip -Force"
                        """

                        // Deploy to Azure Function
                        bat """
                        ${AZ_CLI_PATH} functionapp deployment source config-zip ^
                            --resource-group ${RESOURCE_GROUP} ^
                            --name ${FUNCTION_APP_NAME} ^
                            --src deployment.zip
                        """

                        echo "🌐 Deployed at: https://${FUNCTION_APP_NAME}.azurewebsites.net/api/HelloWorld"

                    } catch (Exception e) {
                        echo "❌ Deployment failed: ${e.message}"
                        currentBuild.result = 'FAILURE'
                        error("Deploy stage failed")
                    } finally {
                        bat "${AZ_CLI_PATH} logout || echo Already logged out"
                    }
                }
            }
        }
    }
}
