pipeline {
    agent any

    environment {
        AZURE_SUBSCRIPTION_ID = credentials('azure-subscription-id')
        AZURE_TENANT_ID       = credentials('azure-tenant-id')
        AZURE_CLIENT_ID       = credentials('azure-client-id')
        AZURE_CLIENT_SECRET   = credentials('azure-client-secret')
        RESOURCE_GROUP        = 'my-azure-functiondemo_group-b294'
        FUNCTION_APP_NAME     = 'my-azure-functiondemo'
        AZURE_REGION          = 'canada central'
    }

    stages {
        stage('Build') {
            steps {
                echo '🔧 Building Azure Functions project...'
                script {
                    bat 'if exist node_modules rmdir /s /q node_modules'
                    bat 'npm install'
                    echo '✅ Build completed successfully'
                }
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                script {
                    try {
                        bat 'npm test'
                        echo '✅ All tests passed successfully'
                    } catch (Exception e) {
                        echo "❌ Tests failed: ${e.message}"
                        currentBuild.result = 'FAILURE'
                        error("Test stage failed")
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 Deploying Azure Function to Azure...'
                script {
                    try {
                        bat """
                        az login --service-principal -u %AZURE_CLIENT_ID% -p %AZURE_CLIENT_SECRET% --tenant %AZURE_TENANT_ID%
                        az account set --subscription %AZURE_SUBSCRIPTION_ID%
                        """

                        // Create deploy folder
                        bat 'if exist deploy rmdir /s /q deploy'
                        bat 'mkdir deploy'
                        bat 'copy package.json deploy\\'
                        bat 'copy host.json deploy\\'
                        bat 'xcopy src deploy\\src /s /e /i /y'

                        // Install production dependencies and zip
                        bat 'cd deploy && npm install --production'
                        bat 'powershell Compress-Archive -Path deploy\\* -DestinationPath deployment.zip -Force'

                        // Deploy to Azure
                        bat """
                        az functionapp deployment source config-zip ^
                            --resource-group %RESOURCE_GROUP% ^
                            --name %FUNCTION_APP_NAME% ^
                            --src deployment.zip
                        """

                        echo "🌐 Your function is live at: https://%FUNCTION_APP_NAME%.azurewebsites.net/api/HelloWorld"

                    } catch (Exception e) {
                        echo "❌ Deployment failed: ${e.message}"
                        currentBuild.result = 'FAILURE'
                        error("Deploy stage failed")
                    } finally {
                        bat 'az logout'
                    }
                }
            }
        }
    }

    post {
        always {
            echo '🧹 Cleaning up workspace...'
            script {
                bat 'if exist deployment.zip del /f /q deployment.zip'
                bat 'if exist deploy rmdir /s /q deploy'
            }
        }
        success {
            echo '🎉 Pipeline completed successfully!'
            echo "🌐 Function deployed at: https://%FUNCTION_APP_NAME%.azurewebsites.net/api/HelloWorld"
        }
        failure {
            echo '💥 Pipeline failed!'
        }
    }
}
